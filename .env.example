# Copy this file to .env (which is gitignored -- never commit your real key) and fill in
# DEEPSEEK_API_KEY. docker-compose.yml reads .env automatically. Without a key, the
# web client's /evidence and /health still work, and the MCP server's list_cases and
# get_evidence still work; run_adjudication and the web client's paid queries do not.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
